  "version": "0.2.0",
  "configurations": [
      {
          "name": "(gdb) Launch",
          "type": "cppdbg",
          "request": "launch",
          // "program": "${workspaceFolder}/client",
          // "program": "${workspaceFolder}/${fileBasenameNoExtension}",
          // "program": "${workspaceFolder}/build/database",
          // "program": "${workspaceFolder}/database",
          // "program": "${workspaceFolder}/build/ezBackup",
          "program": "${workspaceFolder}/build/server",
          // "program": "${workspaceFolder}/build/database",
          // "args": ["localhost", "-p 8080"],
          "args": ["localhost", "8080"],
          // "args": ["71.249.88.137", "8096"],
        //   "args": ["-l ./testcpy -p 8080 -w"],
        //   "args": ["-l", "./testcpy", "-p", "8080", ""],
        //   "args":["/home/jack/Documents/llama-cpp/llama.cpp/common/cmake/build-info-gen-cpp.cmake", "/home/jack/Documents/llama-cpp" ],
          "stopAtEntry": false,
          "cwd": "${fileDirname}",
          "environment": [],
          "externalConsole": false,
          "MIMode": "gdb",
          "setupCommands": [
              {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
              },
              {
                  "description": "Set Disassembly Flavor to Intel",
                  "text": "-gdb-set disassembly-flavor intel",
                  "ignoreFailures": true
              }
          ]
      }


  ]
}